<?xml version="1.0" encoding="utf-8"?>
<!--
  NativeAOT test publish profile for DesomniaService (win-x64).

  Purpose: an AOT feasibility probe for the shared Desomnia core (Autofac + modules).
  DesomniaService is used as the vehicle because it statically links the same core
  features as the Linux daemon and, unlike the daemon, can be AOT-built locally on
  Windows (Windows -> linux-arm64 NativeAOT is not a supported host/target combo).

  Output binary:  DesomniaService\bin\aot-test\DesomniaService.exe   (single self-contained native exe)

  Build it:
    - Easiest:      .\publish-aot-test.ps1        (from the DesomniaService folder)
    - CLI:          dotnet publish DesomniaService\DesomniaService.csproj -p:PublishProfile=AotTest
    - Visual Studio: right-click project -> Publish -> AotTest

  Requirement: the native link step needs vswhere.exe on PATH (it lives in the VS
  Installer directory) plus the "Desktop development with C++" workload. From a plain
  shell this fails with MSB3073 (link.exe exit 123). publish-aot-test.ps1 fixes the
  PATH automatically; Visual Studio already has it set up.

  See AOT-FEASIBILITY.md at the repo root for the full findings and blocker list.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>

    <PublishDir>bin\aot-test\</PublishDir>
  </PropertyGroup>
</Project>
