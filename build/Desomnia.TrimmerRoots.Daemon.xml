<?xml version="1.0" encoding="utf-8"?>
<!--
  Daemon-only trimmer / NativeAOT roots (referenced by DesomniaDaemon in addition to the shared
  Desomnia.TrimmerRoots.xml). "desomniad" is the daemon's entry assembly (see AssemblyName in
  DesomniaDaemon.csproj). The statically-linked plugins (FirewallKnockOperator, FRITZBoxRouter)
  are rooted via PublishAot-conditional TrimmerRootAssembly entries in the csproj instead, since
  they are only referenced in AOT builds.
-->
<linker>
  <assembly fullname="desomniad" preserve="all" />
</linker>
