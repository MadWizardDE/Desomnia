<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>MadWizard.Desomnia.Network.FRITZ</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host-provided assemblies: reference for compilation, never bundle into the plugin
         (a second copy of Core/NetworkMonitor would break type identity across the load context). -->
    <ProjectReference Include="..\..\DesomniaCore\DesomniaCore.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>

    <ProjectReference Include="..\..\modules\NetworkMonitor\NetworkMonitor.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
