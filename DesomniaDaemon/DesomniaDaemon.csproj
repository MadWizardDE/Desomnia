    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>desomniad</AssemblyName>
    <RootNamespace>MadWizard.Desomnia.Daemon</RootNamespace>
    <LangVersion>preview</LangVersion>
